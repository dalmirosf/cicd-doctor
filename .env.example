# Copy to .env (git-ignored) and fill in:  Copy-Item .env.example .env
# The configuration contract of SPEC §4.5. The app reads everything except POSTGRES_* (only
# docker compose reads those) through cicd_doctor/app/settings.py; empty values count as unset.
# tests/unit/test_settings.py fails if this file and the settings drift apart.

# --- Local Postgres (docker compose) ---------------------------------------------------------
POSTGRES_USER=cicd
POSTGRES_PASSWORD=cicd
POSTGRES_DB=cicd_doctor
# Host port of the container (5433 so it does not clash with a native Postgres on 5432)
POSTGRES_PORT=5433

# --- Application ---------------------------------------------------------------------------
APP_ENV=dev
# 127.0.0.1, not localhost: on Windows localhost may try ::1 first and hang (D-52)
DATABASE_URL=postgresql+psycopg://cicd:cicd@127.0.0.1:5433/cicd_doctor
# Tests only (default: DATABASE_URL with "_test" appended to the database name, D-51)
# TEST_DATABASE_URL=postgresql+psycopg://cicd:cicd@127.0.0.1:5433/cicd_doctor_test

# --- GitHub App (dev app via smee.io, D-30) ------------------------------------------------
GITHUB_APP_ID=
# PEM content, or a path to a .pem file (*.pem is git-ignored)
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Set only while rotating the webhook secret
GITHUB_WEBHOOK_SECRET_PREVIOUS=

# --- LLM (D-07, D-16) ------------------------------------------------------------------------
# Global kill switch: false = rules only
LLM_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=
LLM_MAX_OUTPUT_TOKENS=800
LLM_TIMEOUT_S=30
LLM_DAILY_CALLS_PER_INSTALLATION=30
LLM_DAILY_BUDGET_USD=2.00

# --- Log processing (D-11) -------------------------------------------------------------------
LOG_MAX_JOBS=3
LOG_MAX_BYTES=20971520
EXCERPT_MAX_TOKENS=6000

# --- Memory (P2) -----------------------------------------------------------------------------
CACHE_TTL_DAYS=7
SIMILAR_K=3
SIMILAR_MIN_SCORE=0.85

# --- Worker ----------------------------------------------------------------------------------
WORKER_CONCURRENCY=4
JOB_LEASE_S=300
JOB_MAX_ATTEMPTS=5

# --- Observability (P5): tracing is disabled while these are unset ---------------------------
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
