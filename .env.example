# Copy to .env (git-ignored) and fill in:  Copy-Item .env.example .env
# The configuration contract of SPEC §4.5. The app reads everything except POSTGRES_* (only
# docker compose reads those) through cicd_doctor/app/settings.py; empty values count as unset.
# tests/unit/test_settings.py fails if this file and the settings drift apart.

# --- Local Postgres (docker compose) ---------------------------------------------------------
POSTGRES_USER=cicd
POSTGRES_PASSWORD=cicd
POSTGRES_DB=cicd_doctor
# Host port of the container (5433 so it does not clash with a native Postgres on 5432)
POSTGRES_PORT=5433

# --- Application ---------------------------------------------------------------------------
APP_ENV=dev
# text (a terminal) or json (one redacted object per line on stderr; the container uses json, D-117)
LOG_FORMAT=text
LOG_LEVEL=INFO
# 127.0.0.1, not localhost: on Windows localhost may try ::1 first and hang (D-52)
DATABASE_URL=postgresql+psycopg://cicd:cicd@127.0.0.1:5433/cicd_doctor
# Instead of DATABASE_URL (which wins if set), the five parts the AWS tasks get (D-126); the
# password may hold any character
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# Tests only (default: DATABASE_URL with "_test" appended to the database name, D-51)
# TEST_DATABASE_URL=postgresql+psycopg://cicd:cicd@127.0.0.1:5433/cicd_doctor_test

# --- GitHub App (dev app via smee.io, D-30) ------------------------------------------------
GITHUB_APP_ID=
# PEM content (on one line, with \n for the newlines, also works) or a path to a .pem file
# (*.pem is git-ignored)
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Set only while rotating the webhook secret
GITHUB_WEBHOOK_SECRET_PREVIOUS=

# --- LLM (D-07, D-16) ------------------------------------------------------------------------
# Global kill switch: false = rules only
LLM_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=
LLM_MAX_OUTPUT_TOKENS=800
LLM_TIMEOUT_S=30
LLM_DAILY_CALLS_PER_INSTALLATION=30
LLM_DAILY_BUDGET_USD=2.00

# --- Log processing (D-11) -------------------------------------------------------------------
LOG_MAX_JOBS=3
LOG_MAX_BYTES=20971520
EXCERPT_MAX_TOKENS=6000

# --- Memory (P2) -----------------------------------------------------------------------------
CACHE_TTL_DAYS=7
SIMILAR_K=3
SIMILAR_MIN_SCORE=0.85
# The exact search per repository is the default; the HNSW index (pgvector >= 0.8) is for huge repos.
SIMILAR_USE_HNSW=false

# --- Commands (D-95) ------------------------------------------------------------------------
# How many of the most recent failed runs of a pull request one `/cicd-doctor explain` diagnoses.
EXPLAIN_MAX_RUNS=3
# How many suggested changes (review comments with a `suggestion` block) one run attempt posts (D-97).
# 0 turns them off.
EXPLAIN_MAX_SUGGESTIONS=3

# --- Repository configuration (D-90) ------------------------------------------------------
# How long the .github/cicd-doctor.yml of a repository is remembered (a missing file: the second).
CONFIG_TTL_S=300
CONFIG_MISSING_TTL_S=60

# --- Embeddings (D-77, D-78) -----------------------------------------------------------------
# false = the worker runs without the model: no similar failures, the exact-hash cache still works
EMBEDDINGS_ENABLED=true
# Where fastembed keeps the model (66 MB, downloaded in the background on the first start)
EMBEDDING_CACHE_DIR=.cache/fastembed
# ONNX threads; empty = onnxruntime decides (1 to 3 signatures take 4 to 14 ms either way)
EMBEDDING_THREADS=

# --- Retention (FR-18, D-85) -----------------------------------------------------------------
# The daily purge job is created by the worker; false = no purge job is scheduled
PURGE_ENABLED=true
# Hour (UTC) the purge job becomes ready
PURGE_HOUR_UTC=3
RETENTION_DELIVERIES_DAYS=30
# Run attempts with their failures and diagnoses, and the publication records
RETENTION_FAILURES_DAYS=90
# Finished jobs (done, failed, dead): their payloads carry repository data
RETENTION_JOBS_DAYS=30
# An open failure older than this becomes stale
STALE_AFTER_DAYS=30
# Data of an uninstalled installation or a removed repository is purged after this grace
UNINSTALL_GRACE_DAYS=7
# Accepted explain commands (the rate limit table, D-93)
RETENTION_COMMANDS_DAYS=30

# --- Commands (FR-19, D-93) -------------------------------------------------------------------
# One accepted `/cicd-doctor explain` per pull request in this many seconds
COMMAND_WINDOW_S=300

# --- Worker ----------------------------------------------------------------------------------
WORKER_CONCURRENCY=4
JOB_LEASE_S=300
JOB_MAX_ATTEMPTS=5

# --- Observability (P5): tracing is disabled while these are unset ---------------------------
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
