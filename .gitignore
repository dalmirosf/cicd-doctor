# --- Secrets: never commit these ---
.env
.env.*
!.env.example
*.pem

# --- Python / uv ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Tool caches ---
.cache/fastembed/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# --- Editors / OS ---
.idea/
.vscode/
.DS_Store
Thumbs.db

# --- Claude Code: personal overrides stay local (.claude/settings.json is shared) ---
.claude/settings.local.json

# --- Test tools ---
.hypothesis/

# --- Terraform: never commit state, plans, variable values or provider binaries ---
*.tfstate
*.tfstate.*
.terraform/
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.tfplan
!.terraform.lock.hcl
!*.tfvars.example

# Backend settings hold a bucket name tied to the account: keep them local (the .example is tracked)
backend.hcl
